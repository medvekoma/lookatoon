{
  "name": "lookatoon",
  "displayName": "lookAtoon - VS Code TOON viewer",
  "description": "Displays .toon files in a tabular format",
  "version": "0.1.0",
  "publisher": "medvekoma",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/medvekoma/lookatoon"
  },
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "toon",
        "extensions": [
          ".toon"
        ],
        "aliases": [
          "TOON",
          "Toon"
        ]
      }
    ],
    "customEditors": [
      {
        "viewType": "toon.tableView",
        "displayName": "TOON Table View",
        "selector": [
          {
            "filenamePattern": "*.toon"
          }
        ],
        "priority": "default"
      }
    ]
  },
  "scripts": {
    "compile": "rm -rf out && node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "check": "tsc --noEmit",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^18.0.0",
    "@types/vscode": "^1.74.0",
    "@vscode/vsce": "^3.9.1",
    "esbuild": "^0.28.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@toon-format/toon": "^2.3.0"
  }
}
